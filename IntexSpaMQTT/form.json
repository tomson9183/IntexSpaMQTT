{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "BaseTopic",
            "caption": "MQTT-Basis-Thema (Standard: intexspa)"
        },
        {
            "type": "Label",
            "caption": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        },
        {
            "type": "Label",
            "caption": "Energie-Manager (PV-Überschuss-Heizung)"
        },
        {
            "type": "CheckBox",
            "name": "EnableEnergyManager",
            "caption": "Energie-Manager-Unterstützung aktivieren"
        },
        {
            "type": "NumberSpinner",
            "name": "PowerConsumptionHeating",
            "caption": "Leistungsaufnahme Heizung in Watt (typisch: 2200)",
            "minimum": 100,
            "maximum": 5000
        },
        {
            "type": "NumberSpinner",
            "name": "MinPVSurplus",
            "caption": "Minimaler PV-Überschuss zum Einschalten (Watt)",
            "minimum": 100,
            "maximum": 5000
        },
        {
            "type": "SelectVariable",
            "name": "PVSurplusVariableID",
            "caption": "PV-Überschuss-Variable (Watt, positiv = Überschuss)"
        },
        {
            "type": "Label",
            "caption": "Hinweis: Bei aktivem PV-Vorrang darf der Zeitplan die Heizung nur einschalten, wenn genug PV-Überschuss vorhanden ist. Filter/Sprudler/Jets/Hygienisierung bleiben unbeeinflusst."
        },
        {
            "type": "Label",
            "caption": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "Falls oben kein MQTT-Server-Gateway verbunden ist, hier per Knopfdruck verbinden:"
        },
        {
            "type": "Button",
            "caption": "Mit MQTT Server verbinden",
            "onClick": "ISPA_ConnectGateway($id);"
        },
        {
            "type": "Button",
            "caption": "Status anfordern",
            "onClick": "ISPA_RequestStatus($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Aktiv"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Kein MQTT-Parent verbunden"
        }
    ]
}
