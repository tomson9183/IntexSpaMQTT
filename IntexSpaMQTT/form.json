{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "BaseTopic",
            "caption": "MQTT-Basis-Thema (Standard: intexspa)"
        },
        {
            "type": "Label",
            "caption": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        },
        {
            "type": "Label",
            "caption": "Anbindung an den offiziellen 'Energie Manager'"
        },
        {
            "type": "CheckBox",
            "name": "EnableEnergyManager",
            "caption": "PV-Heizung-Schalter bereitstellen (für Energie Manager)"
        },
        {
            "type": "Label",
            "caption": "Es entsteht die Variable 'PV-Heizung (Energie Manager)'. Diese trägst du im Energie Manager als Verbraucher ein. Beim Einschalten macht das Modul automatisch zuerst den Strom an und dann die Heizung; beim Ausschalten erst die Heizung aus und dann das Gerät (falls keine andere Funktion läuft)."
        },
        {
            "type": "NumberSpinner",
            "name": "PowerConsumptionHeating",
            "caption": "Leistungsaufnahme Heizung in Watt (typisch: 2200)",
            "minimum": 100,
            "maximum": 5000
        },
        {
            "type": "Label",
            "caption": "── Manueller Vorrang ──────────────────────────"
        },
        {
            "type": "Label",
            "caption": "Schaltest du Heizung oder Gerät von Hand (Kachel/Gerät), wird die Variable 'PV-Automatik freigegeben' auf AUS gesetzt. Trage diese Variable im Energie Manager beim Verbraucher unter 'Bedingung' ein (muss WAHR sein) – dann übersteuert die Automatik deine Handschaltung nicht mehr."
        },
        {
            "type": "SelectScript",
            "name": "ManualPushScriptID",
            "caption": "Push-Skript für Erinnerung (optional, 0 = nur Log)"
        },
        {
            "type": "NumberSpinner",
            "name": "ManualOverrideResumeHours",
            "caption": "PV-Automatik nach X Stunden automatisch wieder freigeben (0 = nie)",
            "minimum": 0,
            "maximum": 48
        },
        {
            "type": "Label",
            "caption": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "Falls oben kein MQTT-Server-Gateway verbunden ist, hier per Knopfdruck verbinden:"
        },
        {
            "type": "Button",
            "caption": "Mit MQTT Server verbinden",
            "onClick": "ISPA_ConnectGateway($id);"
        },
        {
            "type": "Button",
            "caption": "Status anfordern",
            "onClick": "ISPA_RequestStatus($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Aktiv"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Kein MQTT-Parent verbunden"
        }
    ]
}
